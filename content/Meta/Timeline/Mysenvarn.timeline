      <fuzzy_start>False</fuzzy_start>
      <fuzzy_end>False</fuzzy_end>
      <locked>False</locked>
      <ends_today>False</ends_today>
      <category>Biology</category>
      <description>Searching for a way to effectively combat the territorial spread of plants, animals would be invented by an unknown God, they would release no star detailing their invention. Though these first forms would be simple.</description>
      <default_color>192,192,192</default_color>
