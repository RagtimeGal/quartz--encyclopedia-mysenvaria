      <fuzzy_end>False</fuzzy_end>
      <locked>False</locked>
      <ends_today>False</ends_today>
      <category>History</category>
      <description>A period of the God-War which historians note for the increase in mortal-God relations at the time. It is responsible for the birth of many Demi-Gods and Womb-Gods which are still alive today, and many more of whom are lost to history.</description>
      <default_color>192,192,192</default_color>
    </event>
    <event>
      <start>-178</start>
      <end>-178</end>
      <text>First Epoch Star</text>
