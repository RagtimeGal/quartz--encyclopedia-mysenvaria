		{"id":"bc5311d0059dad2f","type":"text","text":"# Iron Isotopes\nThe God of Iron creates the Iron Isotope Gods. Documented in the Iron Isotopes Star.\n%%\n+100\n%%","x":-14980,"y":-2960,"width":400,"height":200,"color":"6"},
		{"id":"ad90619bf590f2b2","type":"text","text":"# Oxygen Isotopes\nThe God of Oxygen creates the Oxygen Isotope Gods. Documented in the Oxygen Isotopes Star.\n%%\n+40\n%%","x":-14240,"y":-3620,"width":400,"height":200,"color":"5"},
		{"id":"60eb1c047d66f4d9","type":"text","text":"# Helium Isotopes\nThe God of Helium creates the Helium Isotope Gods. Documented in the Helium Isotopes Star.\n%%\n+40\n%%","x":-14980,"y":-3620,"width":400,"height":200,"color":"5"},
		{"id":"7163758b684dfdae","type":"text","text":"# Tin Isotopes\nThe God of Tin creates the Tin Isotope Gods. Documented in the Tin Isotopes Star.\n%%\n+100\n%%","x":-14240,"y":-3400,"width":400,"height":200,"color":"5"},
		{"id":"3369c13669d33f2e","type":"text","text":"# Hydrogen Isotopes\nThe God of Hydrogen creates the Hydrogen Isotope Gods. Documented in the Hydrogen Isotopes Star.\n%%\n+40\n%%","x":-14240,"y":-3180,"width":400,"height":200,"color":"5"},
		{"id":"0863a497a735dfdd","type":"text","text":"# 1st Gen. Carbon Molecules\nThe God of Carbon works with their Isotopes to create the first Molecular Gods, and the first generation of Carbon Molecule Gods. Documented in the First Molecules Star.\n%%\n+1000\n%%","x":-14980,"y":-280,"width":400,"height":200,"color":"5"},
		{"id":"93372ceb44822905","type":"text","text":"# God of Structure\nCreated by Matter and Energy to preside over the structure of matter. Documented in the Structure Star.\n%%\n+1\n%%","x":-14980,"y":3360,"width":400,"height":200,"color":"6"},
		{"id":"183ac1bc89d86125","type":"text","text":"# 1st Gen. Silicon Molecules\nThe God of Silicon works with their Isotopes to create the first generation of Silicon Molecule Gods. Documented in the First Silicon Molecules Star.\n%%\n+400\n%%","x":-14980,"y":-60,"width":400,"height":200,"color":"5"},
		{"id":"4974a5e1ea992a7d","type":"text","text":"# Thulium Isotopes\nThe God of Thulium creates the Thulium Isotope Gods. Documented in the Thulium Isotopes Star.\n%%\n+200\n%%","x":-14240,"y":-2960,"width":400,"height":200,"color":"6"},
		{"id":"c9f76efa6486d9f4","type":"text","text":"# 1st Gen. Cobalt Molecules\nThe God of Cobalt works with their Isotopes to create the first generation of Cobalt Molecule Gods. Documented in the First Cobalt Molecules Star.\n%%\n+1000\n%%","x":-11280,"y":-280,"width":400,"height":200,"color":"5"},
		{"id":"21da0d7128364da1","type":"text","text":"# God of Solid Mechanics\nCreated by the Material States and various Energy Gods to preside over Solid Dynamics. Documented in the Split Mechanics Star.\n%%\n+1\n%%","x":-11280,"y":4520,"width":400,"height":200,"color":"6"},
		{"id":"827ac13e9d1de068","type":"text","text":"# Argon Isotopes\nThe God of Argon creates the Argon Isotope Gods. Documented in the Argon Isotopes Star.\n%%\n+40\n%%","x":-12760,"y":-2520,"width":400,"height":200,"color":"5"},
		{"id":"062462c7b7d8d72e","type":"text","text":"# God of Oscillation\nCreated by the God of Rotational Motion to preside over oscillatory motion. Documented in the Oscillation Star.\n%%\n+1\n%%","x":-12020,"y":-4800,"width":400,"height":200,"color":"4"},
		{"id":"ae54a80787220943","type":"text","text":"# Sodium Isotopes\nThe God of Sodium creates the Sodium Isotope Gods. Documented in the Sodium Isotopes Star.\n%%\n+40\n%%","x":-12760,"y":-3180,"width":400,"height":200,"color":"5"},
		{"id":"ce7b8e1b37526689","type":"text","text":"# Indium Isotopes\nThe God of Indium creates the Indium Isotope Gods. Documented in the Indium Isotopes Star.\n%%\n+100\n%%","x":-12020,"y":-3180,"width":400,"height":200,"color":"5"},
		{"id":"0ff74cdfbdaf1622","type":"text","text":"# Cobalt Isotopes\nThe God of Cobalt creates the Cobalt Isotope Gods. Documented in the Cobalt Isotopes Star.\n%%\n+100\n%%","x":-12760,"y":-3840,"width":400,"height":200,"color":"5"},
		{"id":"c177192e0cea131d","type":"text","text":"# Nickel Isotopes\nThe God of Nickel creates the Nickel Isotope Gods. Documented in the Nickel Isotopes Star.\n%%\n+100\n%%","x":-12760,"y":-3620,"width":400,"height":200,"color":"5"},
		{"id":"531c0d2d0788c5f1","type":"text","text":"# Bismuth Isotopes\nThe God of Bismuth creates the Bismuth Isotope Gods. Documented in the Bismuth Isotopes Star.\n%%\n+200\n%%","x":-12760,"y":-3400,"width":400,"height":200,"color":"5"},
		{"id":"7fa141a52faf2068","type":"text","text":"# Bromine Isotopes\nThe God of Bromine creates the Bromine Isotope Gods. Documented in the Bromine Isotopes Star.\n%%\n+100\n%%","x":-12020,"y":-3400,"width":400,"height":200,"color":"5"},
		{"id":"a6eb165b7e16ccea","type":"text","text":"# Rhodium Isotopes\nThe God of Rhodium creates the Rhodium Isotope Gods. Documented in the Rhodium Isotopes Star.\n%%\n+100\n%%","x":-11280,"y":-3840,"width":400,"height":200,"color":"5"},
		{
			"id":"d2909a376ec98687",
			"type":"text",
			"text":"# Xenon Isotopes\nThe God of Xenon creates the Xenon Isotope Gods. Documented in the Xenon Isotopes Star.\n%%\n+100\n%%",
			"styleAttributes":{
				"textAlign":null
			},
			"x":-11280,
			"y":-3620,
			"width":400,
			"height":200,
			"color":"6"
		},
		{"id":"fe07d9798a3ae213","type":"text","text":"# Reaction Gods\nCreated by the God of Chemical Reactions to preside over different portions of their domain. Documented in the Chemical Reactions Star.\n\n---\n- Endothermic\n- Exothermic\n- Acids\n- Bases\n\n%%\n+4\n%%","x":-12020,"y":-4360,"width":400,"height":200,"color":"6"},
		{"id":"f302f0df82a517a5","type":"text","text":"# God of Orbital Motion\nCreated by the God of Gravitational Motion to preside over orbital motion. Documented in the Orbital Systems Star.\n\n%%\n+1\n%%","x":-12020,"y":-4580,"width":400,"height":200,"color":"6"},
		{"id":"8cdb843f02c600cb","type":"text","text":"# Fluorine Isotopes\nThe God of Fluorine creates the Fluorine Isotope Gods. Documented in the Fluorine Isotopes Star.\n%%\n+40\n%%","x":-12020,"y":-3840,"width":400,"height":200,"color":"5"},
		{"id":"5cb5190caf43dca3","type":"text","text":"# Magnesium Isotopes\nThe God of Magnesium creates the Magnesium Isotope Gods. Documented in the Magnesium Isotopes Star.\n%%\n+40\n%%","x":-12020,"y":-3620,"width":400,"height":200,"color":"5"},
		{"id":"e9a90b3cb25d4cf4","type":"text","text":"# 17,770","x":-12020,"y":-5760,"width":400,"height":200},
		{"id":"3e5d4f9dbe11d315","type":"text","text":"# Transformation Gods\nCreated by various Movement Gods to preside over transformations of geometry. Documented in the Transformation Gods Star.\n\n---\n- Translation\n- Reflection\n- Rotation\n- Dilation\n%%\n+4\n%%","x":-12020,"y":-5240,"width":400,"height":200,"color":"4"},
		{"id":"69e7ae6a1a2a11da","type":"text","text":"# God of Mechanical Waves\nCreated by the God of Mechanical Energy and the God of Linear Motion to preside over mechanical waves. Documented in the Mechanical Waves Star.\n%%\n+1\n%%","x":-12020,"y":-5020,"width":400,"height":200,"color":"6"},
		{"id":"c8341eeac7e4ecf2","type":"text","text":"# 21,630","x":-11280,"y":-5760,"width":400,"height":200},
		{"id":"95f83b4fdba43efd","type":"text","text":"# Basic Gods\nCreated by the God of Bases to preside over different levels of basic materials. Documented in the Acidic Chemicals Star.\n%%\n+20\n%%","x":-11280,"y":-5020,"width":400,"height":200,"color":"4"},
		{"id":"73b6a22d79f0013e","type":"text","text":"# Acidic Gods\nCreated by the God of Acids to preside over different levels of acidity. Documented in the Acidic Chemicals Star.\n%%\n+20\n%%","x":-11280,"y":-5240,"width":400,"height":200,"color":"4"},
		{"id":"68783e93401df7e2","type":"text","text":"# 8535\nCarbon creates the first Allotrope Gods.","x":-12760,"y":-5760,"width":400,"height":200},
		{"id":"459513588d829fd3","type":"text","text":"# Silver Isotopes\nThe God of Silver creates the Silver Isotope Gods. Documented in the Silver Isotopes Star.\n%%\n+100\n%%","x":-14240,"y":-3840,"width":400,"height":200,"color":"5"},
		{"id":"2aff1064b0592eef","type":"text","text":"# Carbon Isotopes\nThe [[Encyclopedia Mysenvaria/History/Biographies/Gods/Elemental Gods/God of Carbon|God of Carbon]] creates the first [[Encyclopedia Mysenvaria/History/Biographies/Gods/Isotope Gods|Isotope Gods]], creating the first generation of Carbon isotopes. Documented in the First Isotopes Star.\n%%\n+40\n%%","x":-14980,"y":-3840,"width":400,"height":200,"color":"5"},
		{
			"id":"809cf484139dba2c",
			"type":"text",
			"text":"# Elemental Gods\nA large, unknown, quantity of Gods created by Matter and documented in the First Lessers Star.\n%%\n+200\n%%",
			"styleAttributes":{
				"border":null
			},
			"x":-15720,
			"y":-4100,
			"width":400,
			"height":220,
			"color":"5"
		},
		{"id":"56c0c293f34f204b","type":"text","text":"# Neon Isotopes\nThe God of Neon creates the Neon Isotope Gods. Documented in the Neon Isotopes Star.\n%%\n+40\n%%","x":-14980,"y":-2740,"width":400,"height":200,"color":"5"},
		{"id":"e068567e4f104d76","type":"text","text":"# 207\nMatter creates the first lesser-Gods in the form of various Elemental Gods. Energy, motivated by Matter, creates the first Energy Gods in the form of Kinetic & Potential Energy.","x":-15720,"y":-5760,"width":400,"height":200},
		{"id":"d248f0b507535043","type":"text","text":"# 5\nWhat Is and Is Not subdivide their domain and create the [[Encyclopedia Mysenvaria/History/Biographies/Gods/Gods of Matter, Energy, Time, and Space|Creation Quadrinity]] sometime before the 58th of Winter, 178 BT.","x":-16460,"y":-5760,"width":400,"height":200},
		{"id":"919e3af40baa4171","type":"text","text":"# Kinetic & Potential Energy\n[[Encyclopedia Mysenvaria/History/Biographies/Gods/Energy Gods/Gods of Kinetic & Potential Energy|AKA the Energy Duo]]. Created by Energy after witnessing the creation of the Elemental Gods by Matter. Documented in the Energy Division Star.\n%%\n+2\n%%","x":-15720,"y":-5240,"width":400,"height":200,"color":"6"},
		{"id":"f374fee20a9769a6","type":"text","text":"# Creation Quadrinity\n[[Encyclopedia Mysenvaria/History/Biographies/Gods/Gods of Matter, Energy, Time, and Space|AKA the Gods of Matter, Energy, Time, and Space]]. Matter is the primary instigator of the [[Encyclopedia Mysenvaria/History/God-War Era/Quickening|Quickening]] and [[Encyclopedia Mysenvaria/History/God-War Era/God-War Era|God-War]]. Documented in the [[Encyclopedia Mysenvaria/Geography/Stars/First Epoch Star|First Epoch Star]].\n%%\n+4\n%%","x":-16460,"y":-5500,"width":400,"height":200,"color":"6"},
		{"id":"5a248526e4fc0994","type":"text","text":"# 0\nNo stars are published.","x":-17180,"y":5720,"width":400,"height":200},
		{"id":"0cc0c7c210d14494","type":"text","text":"A list of published [[Encyclopedia Mysenvaria/Science/Phenomena/Stars|stars]] during that day. In order of publishment.","x":-17660,"y":5720,"width":380,"height":200},
		{"id":"62944587719ad86a","type":"text","text":"# 3\n1. First Lessers Star\n2. Energy Division Star","x":-15720,"y":5720,"width":400,"height":200},
		{"id":"c542853f80c0c80f","type":"text","text":"# 1\n1. [[Encyclopedia Mysenvaria/Geography/Stars/First Epoch Star|First Epoch Star]]","x":-16460,"y":5720,"width":400,"height":200},
		{"id":"eabcc202b5db4093","type":"text","text":"---\ntitle: \"Kaleidoscope Lineage Model\"\nenableToc: false\ntags:\n  - topic/science/model\n  - subject/god\ntype: canvas\nstatus: complete\nfuture: review\n---\n# Kaleidoscope Lineage Model\n\n> [!warning] [[Meta/Meta|Meta]] || [[Meta/Callouts#Names|Names]]\n> Some names in this article are placeholders! Until the setting's history is developed further—allowing for languages and the likes to be constructed accurately—temporary names are used for places, people, and things.\n> \n> These placeholder names may resemble real people, be simple descriptions, or even appear as random jumbles of letters or numbers.\n> \n> The intent is to keep track of these placeholders so that they may be replaced in the future. If you find a name which looks out of place, report it through a [GitHub issue](https://github.com/RagtimeGal/quartz--encyclopedia-mysenvaria/issues/new/choose)!\n\n","x":-18140,"y":-5980,"width":400,"height":460},
		{"id":"7a3d9165e77f5db0","type":"text","text":"# Higher-Gods\nPurple marks a card as being a higher-God; one whose domain, upon their death, will cease existence so long as there are no other higher-Gods or lesser-Gods further in their lineage who hold a complete portion of their domain.\n\nWhen a higher-God is created they are given complete control over a portion of their parent's domain. When they die, their creators do not assume control of this portion of their domain again.\n\nUnless a higher-God has created another higher-God or a lesser-God to continue their lineage, their domain is not passed down, and it ceases to exist altogether.","x":-18140,"y":-5500,"width":400,"height":460,"color":"6"},
		{"id":"3eb56192fc905f48","type":"text","text":"Energy Gods are those whose domains consist of the potential for [[Encyclopedia Mysenvaria/Science/Models/Material|material]] to undergo [[Encyclopedia Mysenvaria/Science/Models/Relationships (model)|relationships]]. Energy Gods descend from the [[Encyclopedia Mysenvaria/History/Biographies/Gods/Gods of Matter, Energy, Time, and Space|God of Energy]], who had originally only created the [[Encyclopedia Mysenvaria/History/Biographies/Gods/Energy Gods/Gods of Kinetic & Potential Energy|Gods of Kinetic & Potential Energy]].","x":-17680,"y":-5240,"width":400,"height":200},
		{"id":"b9bcb18c38bda741","type":"text","text":"Material Gods are those whose domain consists of basal material, like elements, isotopes, and molecules. These are Gods which are descended from the [[Encyclopedia Mysenvaria/History/Biographies/Gods/Gods of Matter, Energy, Time, and Space|God of Matter]] and make up the vast majority of Gods.","x":-17700,"y":-4100,"width":400,"height":200},
		{"id":"df063c0e50e7883c","type":"text","text":"# What Is and Is Not\n[[Encyclopedia Mysenvaria/History/Biographies/Gods/Gods of What Is and Is Not|AKA the Binary Gods or The Fog]]. These are the creators of the [[Encyclopedia Mysenvaria/Geography/Natural Features/Plane|Plane]].\n%%\n+1\n%%","x":-17180,"y":-5500,"width":400,"height":200,"color":"6"},
		{"id":"b2f1cf719d5f6970","type":"text","text":"# 1\nIt's unclear when the Gods of What Is and Is Not came into existence.","x":-17180,"y":-5760,"width":400,"height":200},
		{"id":"08a327b0db937132","type":"text","text":"Unique Gods are those which do not neatly fit into the various categories which [[Encyclopedia Mysenvaria/Science/Branches/Taxonomy|taxonomists]] and theogenists typically divide Gods into. This group consists mostly of the most powerful Gods, like the [[Encyclopedia Mysenvaria/History/Biographies/Gods/Gods of Matter, Energy, Time, and Space|Creation Quadrinity]].","x":-17680,"y":-5500,"width":400,"height":200},
		{"id":"9a96cc78518a2d3d","type":"text","text":"The theoretical minimum number of Gods and a short status update on what is occurring. [[Encyclopedia Mysenvaria/Science/Branches/Theogenesis|Theogenists]] are not entirely sure on the total number of Gods, but these are their best estimates.","x":-17680,"y":-5760,"width":400,"height":200},
		{"id":"0719e023c112ffe2","type":"text","text":"State Gods are those whose domain consists of chemical molecules and elements in different material states, impacted by the amount of energy in their system.","x":-17680,"y":4040,"width":400,"height":200},
		{"id":"69cbeb97f0bad073","type":"text","text":"Earth Gods are those whose domains consist of emergent dynamics relating to the ground or solid material.","x":-17680,"y":4520,"width":400,"height":200},
		{"id":"18484ea99beb2731","type":"text","text":"Phenomena Gods are those whose domain consists of complex emergent dynamics of Reality.","x":-17700,"y":3360,"width":400,"height":200},
		{"id":"0d616aa5b46c2f63","type":"text","text":"# Deceased\nRed marks a card as being a deceased God; the card is covering an individual or group of Gods which are deceased.\n\nA card does not have to be red to contain deceased Gods, red signifies that all Gods related to that card are deceased.","x":-18140,"y":-4060,"width":400,"height":460,"color":"1"},
		{"id":"199d78de01366a86","type":"text","text":"# Lesser-Gods\nGreen marks a card as being a lesser-God; one whose domain, upon their death, will be passed back to their parents. Lesser-Gods cannot create higher-Gods.\n\nWhen a lesser-God is created they are given partial control of their parent's domain. When they die their parents reassume full control over their full domain again.\n\nLesser-Gods are incapable of creating higher-Gods, as they do not have complete control over their domain and thus cannot divvy a complete portion of their control to new beings.","x":-18140,"y":-5020,"width":400,"height":460,"color":"4"},
		{"id":"f20bf67b840b699e","type":"text","text":"# Mixed Bag\nBlue marks a card as being a mixed bag; the card is covering a group of Gods created by the same parent Gods. This group of Gods consists of neither entirely higher- or lesser-Gods. It's a mixed bag of Gods.","x":-18140,"y":-4540,"width":400,"height":460,"color":"5"},
		{"id":"413591cf8a424475","type":"text","text":"# 66\n1. Material States Star\n2. First Bismuth Molecules Star\n3. First Neodymium Molecules Star\n4. Transformation Gods Star\n5. Chemical Reactions Star\n6. First Argon Molecules Star\n7. Fluorine Isotopes Star\n8. First Lithium Molecules Star\n9. Oscillation Star\n10. Magnesium Isotopes Star\n11. First Copper Molecules Star\n12. Bromine Isotopes Star\n13. Orbital Systems Star\n14. First Thulium Molecules Star\n15. Indium Isotopes Star\n16. Vanadium Isotopes Star\n17. Mechanical Waves Star\n18. First Silver Molecules Star\n19. Potassium Isotopes Star","x":-12020,"y":5720,"width":400,"height":600},
		{"id":"ab6f8bc370c71baf","type":"text","text":"# 47\n1. First Tin Molecules Star\n2. Cobalt Isotopes Star\n3. Chemical Reactions Star\n4. Sodium Isotopes Star\n5. First Chlorine Molecules Star\n6. First Oxygen Molecules Star\n7. Argon Isotopes Star\n8. Motion & Movement Star\n9. First Allotropes Star\n10. Bismuth Isotopes Star\n11. Lithium Isotopes Star\n12. Neodymium Isotopes Star\n13. Nickel Isotopes Star","x":-12760,"y":5720,"width":400,"height":440},
		{"id":"232ce6cc41805849","type":"text","text":"Atmosphere Gods are those whose domains consist of emergent dynamics relating to the atmosphere or liquid material.","x":-17680,"y":5220,"width":400,"height":200},
		{"id":"37290eebe24313b4","type":"text","text":"Allotrope Gods are those whose domain consists of allotropes; material entities made up of uniquely structured elements.","x":-17680,"y":3080,"width":400,"height":200},
		{"id":"56b4384a9e4c65be","type":"text","text":"[[Encyclopedia Mysenvaria/History/Biographies/Gods/Molecular Gods|Molecular Gods]] are those whose domain consists of a basal molecular material.","x":-17680,"y":-280,"width":400,"height":200},
		{"id":"ea41c104c5819906","type":"text","text":"[[Encyclopedia Mysenvaria/History/Biographies/Gods/Isotope Gods|Isotope Gods]] are those whose domain consists of a singular basal isotopic elemental material.","x":-17680,"y":-3840,"width":400,"height":200},
		{"id":"acdc327117a95b69","type":"text","text":"# Order\nThe height at which a card is placed in the timeline does not correlate to the time at which the creation occurred. \n\nThe order of stars in status cards does correlate to the order in which they were published.","x":-18140,"y":-3580,"width":400,"height":460,"color":"2"},
		{"id":"0e44dd56c834de46","type":"text","text":"# Material State Gods\nCreated by Electric, Mechanical, and Magnetic Energy alongside Structure to preside over the various material states of matter. Documented in the Material States Star.\n%%\n+4\n%%","x":-12020,"y":3360,"width":400,"height":200,"color":"6"},
		{"id":"247072c389c0854c","type":"text","text":"# Neodymium Isotopes\nThe God of Neodymium creates the Neodymium Isotope Gods. Documented in the Neodymium Isotopes Star.\n%%\n+200\n%%","x":-12760,"y":-2740,"width":400,"height":200,"color":"5"},
		{"id":"c918b17874cdd0d1","type":"text","text":"# Potassium Isotopes\nThe God of Potassium creates the Potassium Isotope Gods. Documented in the Potassium Isotopes Star.\n%%\n+40\n%%","x":-12020,"y":-2740,"width":400,"height":200,"color":"5"},
		{"id":"4a42946a0e504258","type":"text","text":"# Vanadium Isotopes\nThe God of Vanadium creates the Vanadium Isotope Gods. Documented in the Vanadium Isotopes Star.\n%%\n+100\n%%","x":-12020,"y":-2960,"width":400,"height":200,"color":"5"},
		{
			"id":"5a90e097dffafda4",
			"type":"text",
			"text":"# Lithium Isotopes\nThe God of Lithium creates the Lithium Isotope Gods. Documented in the Lithium Isotopes Star.\n%%\n+40\n%%",
			"styleAttributes":{
				"textAlign":null
			},
			"x":-12760,
			"y":-2960,
			"width":400,
			"height":200,
			"color":"5"
		},
		{"id":"6510b85bc8b006f1","type":"text","text":"# God of Chemical Reactions\nCreated by the Chemical Energy Gods to preside over chemical reactions. Documented in the Chemical Reactions Star.\n%%\n+1\n%%","x":-12760,"y":-5240,"width":400,"height":200,"color":"6"},
		{"id":"6cbb23736909e296","type":"text","text":"# Movement Gods\nCreated by the God of Motion, partially with the help of the God of Gravitational Energy. Documented in the Motion & Movement Star.\n\n---\n- Rotational Motion\n- Friction\n- Transformation\n- Gravitational Motion\n- Linear Motion\n%%\n+5\n%%","x":-12760,"y":-5020,"width":400,"height":200,"color":"6"},
		{
			"id":"1373730fe1fbdaa1",
			"type":"text",
			"text":"# Carbon Allotropes\nThe God of Carbon, with the God of Structure, creates the first Allotrope Gods to oversee the allotropes in their domain. Documented in the First Allotropes Star.\n%%\n+200\n%%",
			"styleAttributes":{},
			"x":-12760,
			"y":3080,
			"width":400,
			"height":200,
			"color":"5"
		},
		{"id":"a9f06a41e95f2238","type":"text","text":"# 34\n1. Aluminum Isotopes Star\n2. Nuclear Physics Star\n3. First Helium Molecules\n4. Chlorine Isotopes Star\n5. Chemical Energy Star\n6. First Nitrogen Molecules\n7. Copper Isotopes Star\n8. Temperature Star","x":-13500,"y":5720,"width":400,"height":300}
	],
